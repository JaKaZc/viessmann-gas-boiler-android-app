    <string name="check_room_below">%1$s° below target on average</string>
    <string name="check_room_above">%1$s° above target on average</string>
    <string name="check_room_on">On target on average</string>
    <string name="check_room_split">Below 5 °C outside: %1$s · above: %2$s</string>
    <string name="check_room_good">The rooms reach the temperature you set: the heating curve fits your house.</string>
    <string name="check_room_cold">The rooms stay cooler than set: the supply temperature is too low for your house.</string>
    <string name="check_room_warm">The rooms get warmer than set. Each degree less saves roughly 6 %% gas.</string>
    <string name="check_room_slope">The difference depends on the outside temperature, so the slope (steepness of the curve) is the right setting.</string>
    <string name="check_room_shift">The difference is about the same at all outside temperatures, so the shift is the right setting.</string>
    <string name="check_room_curve_slope">Heating curve slope %1$s → %2$s. Change in small steps and check again after a day or two.</string>
    <string name="check_room_curve_shift">Heating curve shift %1$s → %2$s K. Change in small steps and check again after a day or two.</string>
    <string name="check_room_none">No room temperature sensor: the check cannot compare the rooms with your targets.</string>
    <string name="check_open_heating">Open heating settings</string>

    <string name="check_comfort_title">Comfort program</string>
    <string name="check_comfort_text">Comfort (%1$s°) is lower than Normal (%2$s°). Comfort is usually the warmest program; check that this is intended.</string>

    <string name="check_setback_title">Night setback</string>
    <string name="check_setback_value">Normal %1$s° · Reduced %2$s°</string>
    <string name="check_setback_share">Reduced active %1$s %% of the time</string>
    <string name="check_setback_good">A moderate setback of %1$s°: saves gas at night without a long warm-up.</string>
    <string name="check_setback_none">Reduced is (almost) the same as Normal, so nothing is saved at night. Reduced 2–3° below Normal usually saves several percent of gas.</string>
    <string name="check_setback_large">A setback of %1$s° is large: warming the house up again in the morning costs a lot of gas. 2–3° is usually the better balance with a condensing boiler.</string>

    <string name="check_supply_title">Condensing</string>
    <string name="check_supply_value">Average supply %1$s °C while the burner runs (max %2$s °C)</string>
    <string name="check_supply_good">Low supply temperatures: the boiler condenses and also uses the heat in the exhaust.</string>
    <string name="check_supply_mid">Supply temperatures of 50–60 °C limit condensing. If the rooms stay warm enough, a slightly lower heating curve improves efficiency.</string>
    <string name="check_supply_high">Above 60 °C the boiler hardly condenses. Lower the heating curve or the maximum supply temperature if the rooms stay warm enough.</string>

    <string name="check_mild_title">Mild days</string>
    <string name="check_mild_value">%1$s %% of the week at 16 °C or more outside · burner on %2$s %% of that time</string>
    <string name="check_mild_good">The heating stays off when it is mild outside.</string>
    <string name="check_mild_bad">The heating still runs when it is mild outside. Standby (summer) mode on warm days, or a lower curve shift, avoids heating you don\'t need.</string>

    <string name="check_pressure_title">System pressure</string>
    <string name="check_pressure_value">%1$s – %2$s bar</string>
    <string name="check_pressure_good">Stable pressure within your limits.</string>
    <string name="check_pressure_drop">The pressure dropped by %1$s bar this week. A slow drop can mean air in the system or a small leak; watch it and refill below %2$s bar.</string>
    <string name="check_pressure_out">The pressure left your limits (%1$s – %2$s bar). Check the system: too low a pressure stops the boiler.</string>

    <string name="check_gas_title">Gas use</string>
    <string name="check_gas_value">%1$s m³ in 7 days</string>
    <string name="check_gas_degree">%1$s m³ per degree day</string>
    <string name="check_gas_text">Per degree day compares weeks with different weather: lower is better. Run the check again after changing a setting to see the effect.</string>

    <string name="check_data_title">Data</string>
    <string name="check_data_value">%1$s %% of the expected background refreshes · %2$d snapshots</string>
    <string name="check_data_good">Enough data for a reliable check.</string>
    <string name="check_data_bad">Many background refreshes were missed, most likely by battery saving. Allow ViGasBoiler to run unrestricted for more precise results.</string>
