<?xml version="1.0" encoding="utf-8"?>
<!-- Modulation ring around the burner flame (like the Overview card): a track and an arc that
     starts at 12 o'clock. Ring geometry: thickness = width/14, inner radius = width/2 - thickness. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.333"
            android:shape="ring"
            android:thicknessRatio="14"
            android:useLevel="false">
            <solid android:color="@color/widget_ring_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.333"
                android:shape="ring"
                android:thicknessRatio="14"
                android:useLevel="true">
                <solid android:color="@color/widget_flame" />
            </shape>
        </rotate>
    </item>
</layer-list>
