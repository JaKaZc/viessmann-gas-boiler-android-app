<?xml version="1.0" encoding="utf-8"?>
<!--
    Include-only: anything not named here stays on the phone, including the sign-in tokens and
    their key (useless elsewhere, bound to this device's Keystore). The history goes in as compact
    daily files, the database itself would pass the 25 MB limit after about three months.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="history-backup/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/client.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="history-backup/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/client.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
